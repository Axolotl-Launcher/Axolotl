{
  "name": "@modrinth/app-frontend",
  "private": true,
  "version": "1.10.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "contributors:sync": "node ../../scripts/axolotl/sync-contributors.mjs",
    "tsc:check": "vue-tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "fix": "eslint . --fix && prettier --write .",
    "intl:extract": "formatjs extract \"src/**/*.{vue,ts,tsx,js,jsx,mts,cts,mjs,cjs}\" --ignore \"**/*.d.ts\" --ignore node_modules --out-file src/locales/en-US/index.json --format crowdin --preserve-whitespace",
    "intl:prune-local": "pnpm -w scripts i18n-icu-contract prune-local --scope apps/app-frontend",
    "test": "vue-tsc --noEmit && node --test \"src/**/*.test.ts\"",
    "test:visual": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/utilities": "3.2.2",
    "@dnd-kit/vue": "^0.5.0",
    "@langchain/core": "1.2.14",
    "@lobehub/icons-static-svg": "^1.95.0",
    "@modrinth/api-client": "workspace:^",
    "@modrinth/assets": "workspace:*",
    "@modrinth/server": "workspace:*",
    "@modrinth/ui": "workspace:*",
    "@modrinth/utils": "workspace:*",
    "@sfirew/minecraft-motd-parser": "^1.1.6",
    "@tanstack/vue-query": "^5.102.8",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-http": "~2.5.9",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "@types/three": "^0.185.4",
    "@vueuse/core": "^11.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/xterm": "^6.0.0",
    "dayjs": "^1.11.23",
    "deepagents": "1.14.2",
    "deepslate": "^0.26.2",
    "fflate": "^0.8.3",
    "fuse.js": "^6.6.2",
    "intl-messageformat": "^10.7.18",
    "langchain": "1.5.10",
    "langsmith": "0.9.0",
    "lru-cache": "^11.5.2",
    "monaco-editor": "^0.56.0",
    "ofetch": "^1.5.1",
    "overlayscrollbars": "^2.16.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.10.1",
    "three": "^0.185.1",
    "vite-svg-loader": "^5.1.3",
    "vue": "^3.5.42",
    "vue-i18n": "^10.0.8",
    "vue-router": "^4.6.4",
    "vuedraggable": "^4.1.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@formatjs/cli": "^6.16.23",
    "@modrinth/tooling-config": "workspace:*",
    "@nuxt/eslint-config": "^0.5.7",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser-playwright": "^4.1.12",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.5.5",
    "eslint": "^9.39.5",
    "eslint-plugin-turbo": "^2.10.12",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "sass": "^1.104.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.2.4",
    "vite-plugin-node-polyfills": "0.28.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.12",
    "vue-component-type-helpers": "^3.3.11",
    "vue-tsc": "^2.2.12"
  },
  "packageManager": "pnpm@9.4.0",
  "web-types": "../../web-types.json"
}
