{
  "name": "@axolotl/monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "website:dev": "turbo run dev --filter=@axolotl/website",
    "website:build": "turbo run build --filter=@axolotl/website",
    "app:dev": "turbo run dev --filter=@modrinth/app",
    "app:build": "turbo run build --filter=@modrinth/app",
    "build": "turbo run build --continue",
    "lint": "turbo run lint lint:ancillary --continue",
    "lint:ancillary": "prettier --check .github README.md AGENTS.md \"apps/**/AGENTS.md\" \"packages/**/AGENTS.md\" .agents/AGENTS.md \".agents/skills/*/SKILL.md\" standards/frontend/DEVELOPMENT.md standards/frontend/FIGMA_MCP_USAGE.md standards/frontend/ADDING_API_MODULES.md standards/frontend/INTERNATIONALIZATION.md Cargo.toml package.json pnpm-workspace.yaml turbo.jsonc crowdin.yml web-types.json _typos.toml tombi.toml clippy.toml rustfmt.toml",
    "test": "turbo run test --continue",
    "fix": "turbo run fix fix:ancillary --continue",
    "fix:ancillary": "prettier --write .github README.md AGENTS.md \"apps/**/AGENTS.md\" \"packages/**/AGENTS.md\" .agents/AGENTS.md \".agents/skills/*/SKILL.md\" standards/frontend/DEVELOPMENT.md standards/frontend/FIGMA_MCP_USAGE.md standards/frontend/ADDING_API_MODULES.md standards/frontend/INTERNATIONALIZATION.md Cargo.toml package.json pnpm-workspace.yaml turbo.jsonc crowdin.yml web-types.json _typos.toml tombi.toml clippy.toml rustfmt.toml",
    "ci": "turbo run lint test --continue",
    "prepr": "turbo run prepr --continue",
    "prepr:frontend": "turbo run prepr --filter=@modrinth/app-frontend --filter=@axolotl/website",
    "prepr:frontend:lib": "turbo run prepr --filter=@modrinth/ui --filter=@modrinth/assets --filter=@modrinth/api-client --filter=@modrinth/utils --filter=@modrinth/server --filter=@modrinth/tooling-config",
    "prepr:frontend:app": "turbo run prepr --filter=@modrinth/app-frontend",
    "prepr:website": "turbo run prepr --filter=@axolotl/website",
    "icons:add": "pnpm --filter @modrinth/assets icons:add",
    "scripts": "node scripts/run.mjs",
    "axolotl:brand-guard": "node scripts/axolotl/brand-guard.mjs",
    "axolotl:check-agents": "node scripts/axolotl/check-agents.mjs",
    "axolotl:check-css-vars": "node scripts/axolotl/check-css-vars.mjs",
    "axolotl:check-orphan-components": "node scripts/axolotl/check-orphan-components.mjs",
    "blockbench:skin:sync": "node scripts/axolotl/sync-blockbench-skin-editor.mjs",
    "axolotl:i18n-check": "node scripts/axolotl/i18n-check.mjs",
    "axolotl:check-chinese": "node scripts/axolotl/check-chinese-hardcoded.mjs"
  },
  "devDependencies": {
    "@clack/prompts": "^1.0.0",
    "@crowdin/crowdin-api-client": "^1.55.2",
    "@formatjs/icu-messageformat-parser": "^2.11.4",
    "@modrinth/tooling-config": "workspace:*",
    "@tailwindcss/container-queries": "^0.1.1",
    "@types/node": "^24",
    "@vue/compiler-dom": "^3.5.26",
    "@vue/compiler-sfc": "^3.5.26",
    "chalk": "^5.6.2",
    "happy-dom": "^21.0.4",
    "if-ci": "^3.0.0",
    "keep-a-changelog": "^3.0.2",
    "pngjs": "7.0.0",
    "prettier": "^3.9.6",
    "turbo": "^2.11.8",
    "vue": "^3.5.42",
    "yaml": "^2.8.3"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.15.0"
  },
  "pnpm": {
    "overrides": {
      "typescript": "5.9.3",
      "@nuxt/devtools": ">=3.3.1 <4.0.0",
      "vue": ">=3.5.44 <4.0.0",
      "launch-editor": ">=2.14.2 <3.0.0",
      "shell-quote": ">=1.9.0 <2.0.0",
      "h3": ">=1.15.9 <2.0.0",
      "defu": ">=6.1.7 <7.0.0",
      "devalue": ">=5.9.3 <6.0.0",
      "nanotar": ">=0.2.1 <0.3.0",
      "nitropack": ">=2.13.4 <3.0.0",
      "seroval": ">=1.6.3 <2.0.0",
      "axios": ">=1.20.0 <2.0.0",
      "follow-redirects": ">=1.16.1 <2.0.0",
      "form-data": ">=4.0.6 <5.0.0",
      "dompurify": ">=3.4.17 <4.0.0",
      "undici": ">=7.29.1 <8.0.0",
      "ws": ">=8.21.0 <9.0.0",
      "sharp": ">=0.35.5 <0.36.0",
      "tar": ">=7.5.21 <8.0.0",
      "happy-dom": ">=21.0.4 <22.0.0",
      "@cloudflare/vitest-pool-workers>zod": ">=4.6.6 <5.0.0",
      "yaml": ">=2.8.3 <2.9.0",
      "node-forge": ">=1.4.0 <2.0.0",
      "lodash": ">=4.18.0 <5.0.0",
      "source-map-js": ">=1.2.2 <2.0.0",
      "browserslist": ">=4.28.7 <5.0.0",
      "baseline-browser-mapping": ">=2.11.0 <3.0.0",
      "minimatch@3>brace-expansion": ">=1.1.21 <2.0.0",
      "minimatch@5>brace-expansion": ">=2.1.7 <3.0.0",
      "minimatch@9>brace-expansion": ">=2.1.7 <3.0.0",
      "minimatch@10>brace-expansion": ">=5.0.12 <6.0.0",
      "@nuxt/vite-builder>esbuild": ">=0.28.2 <0.29.0",
      "nitropack>esbuild": ">=0.28.2 <0.29.0",
      "srvx": ">=0.11.13 <0.12.0",
      "serialize-javascript": ">=7.0.5 <8.0.0",
      "postcss-selector-parser": ">=7.1.6 <8.0.0"
    },
    "patchedDependencies": {
      "readable-stream@2.3.8": "patches/readable-stream@2.3.8.patch"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "vite": "8",
        "esbuild": "0"
      }
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@sentry/cli",
      "core-js",
      "esbuild",
      "protobufjs",
      "sharp",
      "unrs-resolver",
      "vue-demi",
      "workerd"
    ]
  },
  "prettier": "@modrinth/tooling-config/prettier.config.cjs"
}
