{
  "name": "@modrinth/ui",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "main": "./index.ts",
  "types": "./index.ts",
  "imports": {
    "#ui/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./index.ts",
      "node": "./node.ts",
      "default": "./index.ts"
    },
    "./locales.eager": "./src/locales.eager.ts",
    "./styles/*": "./src/styles/*",
    "./src/*": "./src/*",
    "./directives/*": "./src/directives/*"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "test": "node --test \"src/**/*.test.ts\" && vitest run --config vitest.config.ts",
    "test:visual": "vitest run --config vitest.config.ts",
    "fix": "eslint . --fix && prettier --write .",
    "intl:extract": "formatjs extract \"src/**/*.{vue,ts,tsx,js,jsx,mts,cts,mjs,cjs}\" --ignore \"src/**/*.d.ts\" --out-file src/locales/en-US/index.json --preserve-whitespace",
    "intl:prune-local": "pnpm -w scripts i18n-icu-contract prune-local --scope packages/ui"
  },
  "devDependencies": {
    "@formatjs/cli": "^6.16.23",
    "@modrinth/tooling-config": "workspace:*",
    "@stripe/stripe-js": "^7.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/browser-playwright": "^4.1.12",
    "@vue/test-utils": "^2.4.6",
    "playwright": "^1.56.0",
    "stripe": "^18.5.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.2.4",
    "vite-svg-loader": "^5.1.3",
    "vitest": "^4.1.12",
    "vue": "^3.5.42",
    "vue-component-type-helpers": "^3.3.11",
    "vue-router": "^4.6.4"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@floating-ui/vue": "^1.1.11",
    "@modrinth/api-client": "workspace:*",
    "@modrinth/assets": "workspace:*",
    "@modrinth/utils": "workspace:*",
    "@sfirew/minecraft-motd-parser": "^1.1.6",
    "@tanstack/vue-query": "^5.102.8",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tresjs/cientos": "^4.3.1",
    "@tresjs/core": "^4.3.6",
    "@tresjs/post-processing": "^2.4.0",
    "@types/dompurify": "^3.2.0",
    "@types/markdown-it": "^14.2.0",
    "@types/three": "^0.185.4",
    "@vintl/how-ago": "^3.0.1",
    "@vueuse/core": "^11.3.0",
    "ace-builds": "^1.14.0",
    "apexcharts": "^4.7.0",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.17",
    "es-toolkit": "^1.52.0",
    "fabric": "^7.4.0",
    "flatpickr": "^4.6.13",
    "fuse.js": "^6.6.2",
    "highlight.js": "^11.12.0",
    "intl-messageformat": "^10.7.18",
    "jszip": "^3.10.1",
    "lru-cache": "^11.5.2",
    "markdown-it": "^14.3.3",
    "motion-v": "^2.4.2",
    "overlayscrollbars": "^2.16.0",
    "postprocessing": "^6.39.4",
    "qrcode.vue": "^3.10.0",
    "reka-ui": "^2.10.1",
    "three": "^0.185.1",
    "vue-i18n": "^10.0.8",
    "vue-typed-virtual-list": "^1.0.10",
    "vue3-ace-editor": "^2.2.4",
    "vue3-apexcharts": "^1.10.0",
    "xss": "^1.0.15"
  },
  "web-types": "../../web-types.json"
}
